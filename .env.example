# ==============================================================================
# EdWorld Co — Environment Configuration (.env.local)
# ==============================================================================

# Application Base URL & Environment
NEXT_PUBLIC_APP_URL=https://edworldco.in
NEXT_PUBLIC_APP_ENV=development

# ------------------------------------------------------------------------------
# Supabase Database & Auth Client Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# AI & LLM Engine Configuration (Google Gemini / Universal AI)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenRouter / OpenAI Fallback
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------------------------
# Razorpay Payments Configuration (INR / UPI / Cards)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ------------------------------------------------------------------------------
# Resend Transactional Email Provider
# ------------------------------------------------------------------------------
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=EdWorld Co <notifications@edworldco.in>

# ------------------------------------------------------------------------------
# Internal Security, Microservices & Cron Auth
# IMPORTANT: All secrets below must be strong random strings in production.
# Never use placeholder values — the server will reject them.
# ------------------------------------------------------------------------------
CRON_SECRET=generate-with-openssl-rand-hex-32
INTERNAL_SERVICE_SECRET=generate-with-openssl-rand-hex-32
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres

# ------------------------------------------------------------------------------
# Health Endpoint Security
# Used to gate detailed health information to internal monitoring systems only.
# Generate with: openssl rand -hex 32
# ------------------------------------------------------------------------------
HEALTH_CHECK_TOKEN=generate-with-openssl-rand-hex-32

# ------------------------------------------------------------------------------
# Sentry Error Monitoring & Uptime
# ------------------------------------------------------------------------------
SENTRY_DSN=https://your-public-key@sentry.io/project-id
NEXT_PUBLIC_SENTRY_DSN=https://your-public-key@sentry.io/project-id
SYNTHETIC_TARGET_URL=http://localhost:3000

